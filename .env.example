# Copy this file to .env.local and fill in your key.
# Without a key the app runs on clearly-labelled DEMO DATA.

# Twelve Data API key — free tier available at https://twelvedata.com/pricing
MARKET_DATA_API_KEY=

# Symbol requested from the provider.
# NDX = NASDAQ-100 index (may require a paid Twelve Data plan).
# QQQ = NASDAQ-100 ETF, available on the free tier and tracks US100 closely.
MARKET_DATA_SYMBOL=QQQ
